AUTH_SECRET=
AUTH_URL=https://app.directscal.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_DOMAINS=directscal.com,directscal.com.br
AUTH_ALLOWED_EMAILS=admin@directscal.com
AUTH_ORG_BY_DOMAIN={"directscal.com":"Directscal","directscal.com.br":"Directscal"}
AUTH_ADMIN_EMAILS=
AUTH_SUPERADMIN_EMAILS=admin@directscal.com
AUTH_ENABLE_SUPERADMIN_PASSWORD_LOGIN=false
AUTH_SUPERADMIN_PASSWORD=
AUTH_ENABLE_DEV_PASSWORD_LOGIN=false

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Agente de consulta (server-only). Sem provedor, o agente responde em modo
# extrativo, com os trechos publicados citados.
# ASSET_AGENT_PROVIDER: anthropic | gemini | ollama | extractive
ASSET_AGENT_PROVIDER=extractive
# Opcional; padrões: claude-opus-5-5, gemini-3.5-flash-lite, qwen2.5:7b
ASSET_AGENT_MODEL=
# ASSET_EMBEDDING_PROVIDER: gemini | ollama | none (vetores de 768 dimensões)
ASSET_EMBEDDING_PROVIDER=none
# Opcional; padrões: gemini-embedding-001, nomic-embed-text
ASSET_EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Slack (server-only). Com CLIENT_ID/SECRET, cada empresa conecta o próprio
# workspace em /configuracoes.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Fallback para um único workspace de teste, sem OAuth.
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_ORGANIZATION_ID=

# Avaliação offline do agente (npm run eval:seed / npm run eval:agent).
ASSET_EVAL_ORGANIZATION_ID=
ASSET_EVAL_OTHER_ORGANIZATION_ID=
ASSET_EVAL_ACTOR_USER_ID=
ASSET_EVAL_ALLOW_SEED=false

PUBLIC_APP_URL=https://app.directscal.com
NEXT_PUBLIC_EXECUTIVE_CLASS_REGISTRATION_URL=/a/omdx-site
RESEND_API_KEY=
RESEND_FROM_EMAIL=Directscal <convites@directscal.com>
RESEND_REPLY_TO_EMAIL=
FEATURE_ACQUISITION=true
